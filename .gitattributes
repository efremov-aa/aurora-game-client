# Нормализация переводов строк (чтобы bash-скрипты не ломались на Linux/macOS)
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.iss text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.exe binary
*.zip binary
*.png binary
*.ico binary
